# Optional. Copy to .env only if you want to override defaults.
# `docker compose up` works with no .env at all.

# Postgres (compose defaults: postgres / postgres / dashboard)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dashboard

# Leave JWT_SECRET and CRYPTO_KEY empty to auto-generate them into the
# api_secrets Docker volume (or .data/secrets for local `npm run dev`).
JWT_SECRET=
CRYPTO_KEY=

APP_URL=http://localhost:8080

# Mail — default: Mailpit in Docker (no auth). For real Gmail delivery:
#   1. Google Account → Security → App passwords (2FA required)
#   2. Set the vars below, then: docker compose up -d --force-recreate api
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@gmail.com
# SMTP_PASS=xxxx-xxxx-xxxx-xxxx
# SMTP_FROM=Threshold <you@gmail.com>
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# On Render's free plan, outbound SMTP (25/465/587) is blocked, so set this to
# send through Brevo's HTTP API instead (sender verification, no domain
# needed - the email in SMTP_FROM must match the verified sender).
BREVO_API_KEY=

# Weather widgets default to Open-Meteo (no key, but rate-limited per IP).
# Set this to use WeatherAPI.com instead (free key at weatherapi.com, quota
# per key, not per IP - avoids collisions with other apps on a shared IP).
WEATHERAPI_KEY=

# Demo admin (created on first boot). Leave ADMIN_PASSWORD empty to get a
# random password printed once in the api container logs.
ADMIN_EMAIL=admin@threshold.local
ADMIN_PASSWORD=

# Optional GitHub OAuth — omit both to keep OAuth disabled.
# Callback URL to register in the GitHub OAuth App:
#   http://localhost:8080/api/v1/auth/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional server-side GitHub token (higher API rate limits for adapters)
GITHUB_TOKEN=
